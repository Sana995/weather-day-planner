# OpenWeatherMap — free "Current Weather and Forecasts" plan, no credit card
# https://home.openweathermap.org/api_keys  (fresh keys can take up to ~2h to activate)
OPENWEATHER_API_KEY=

# Groq — free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Most Groq completions per UTC day (each chat tool round counts). 0 switches the AI off.
GROQ_DAILY_LIMIT=300

# OPTIONAL — Geoapify Places POI grounding (traveling mode): https://myprojects.geoapify.com/
# Leave empty to skip; Wikivoyage (keyless) + LLM general knowledge still cover traveling mode.
GEOAPIFY_API_KEY=

PORT=3001

# Behind a reverse proxy: how many proxies sit in front of the server, so the
# per-client rate limits see real client IPs. Leave empty when running locally.
TRUST_PROXY=

# OPTIONAL: SearchApi Google Events for real, dated local listings.
# Sign up (no credit card): https://www.searchapi.io/users/sign_up
# Sign-up comes with 100 free requests; the 10-minute cache stretches them.
# Leave empty to skip; guide-derived (undated) festival mentions still work keylessly.
SEARCHAPI_API_KEY=
# Most SearchApi requests per UTC day (a lookup is 1, or 2 with the fallback). 0 switches it off.
SEARCHAPI_DAILY_LIMIT=20
